<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Lot 3.4 (S2) : sauvegarde déclarée explicitement. Elle reste activée (réglages du clavier), mais tout ce
        qui est chiffré avec une clé Keystore, ainsi que les modèles IA, est exclu : voir res/xml/backup_rules.xml
        et data_extraction_rules.xml (testé par BackupRulesTest).

        Direct boot (décision D5) : le clavier n'est volontairement PAS directBootAware. Avant le premier
        déverrouillage après un redémarrage, Android affiche son clavier système ; Taipo reprend ensuite.
        Raison : ses données (dictionnaire personnel, presse-papiers, mot suivant, modèles) sont dans le
        stockage protégé par les identifiants, indisponible avant déverrouillage. Voir docs/securite.md.
    -->
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".KeyboardSettingsActivity"
            android:label="@string/keyboard_settings_title"
            android:exported="false" />

        <activity
            android:name=".ModelSettingsActivity"
            android:label="@string/model_settings_title"
            android:exported="false" />

        <activity
            android:name=".SystemPromptsActivity"
            android:label="@string/system_prompts_title"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".VoiceModelSettingsActivity"
            android:label="@string/voice_model_title"
            android:exported="false" />

        <activity
            android:name=".PersonalDictionaryActivity"
            android:label="@string/personal_dictionary_title"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".VoicePermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- Story 2.6 : modification d'un élément du Smart Clipboard (fenêtre de dialogue lancée par le clavier). -->
        <activity
            android:name=".ClipboardEditActivity"
            android:exported="false"
            android:theme="@style/EditDialogTheme"
            android:windowSoftInputMode="adjustResize|stateVisible"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- Stories 2.7 et 2.8 : étiquette d'un élément épinglé du Smart Clipboard (fenêtre de dialogue lancée par le clavier). -->
        <activity
            android:name=".ClipboardLabelActivity"
            android:exported="false"
            android:theme="@style/EditDialogTheme"
            android:windowSoftInputMode="adjustResize|stateVisible"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <service
            android:name=".TaipoIme"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>

</manifest>