<?xml version="1.0" encoding="utf-8"?>
<!-- Piste du commutateur (lot 17) : violette activée, grise désactivée. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/control_checked" />
            <corners android:radius="@dimen/taipo_switch_track_height" />
            <size android:width="@dimen/taipo_switch_track_width" android:height="@dimen/taipo_switch_track_height" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/switch_track_off" />
            <corners android:radius="@dimen/taipo_switch_track_height" />
            <size android:width="@dimen/taipo_switch_track_width" android:height="@dimen/taipo_switch_track_height" />
        </shape>
    </item>
</selector>
