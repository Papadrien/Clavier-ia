<?xml version="1.0" encoding="utf-8"?>
<!-- Écran « Langues » (piste C) : une ligne résumée par langue utilisée (nom, disposition), un appui ouvre le détail de la
     langue ; « Ajouter une langue » en dernière ligne. Les lignes sont posées par LanguagesActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/taipo_settings_screen_padding">

        <TextView
            style="@style/TaipoText.Title"
            android:id="@+id/languages_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/taipo_settings_gap_xl"
            android:text="@string/languages_title" />

        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm"
            android:text="@string/languages_section_keyboard" />

        <!-- clipToOutline : les retours visuels des lignes suivent les coins arrondis de la carte. -->
        <LinearLayout
            android:id="@+id/languages_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:clipToOutline="true" />

        <TextView
            style="@style/TaipoText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_sm"
            android:text="@string/languages_explanation" />
    </LinearLayout>
</ScrollView>
