<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde et restauration (story 10.3) : deux cartes, exporter et restaurer ; le résultat s'affiche dans des boîtes de dialogue. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/taipo_settings_screen_padding">

        <TextView
            style="@style/TaipoText.Title"
            android:id="@+id/backup_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/backup_title" />

        <TextView
            style="@style/TaipoText.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_sm"
            android:layout_marginBottom="@dimen/taipo_settings_gap_xl"
            android:text="@string/backup_intro" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="@dimen/taipo_settings_card_padding"
            android:layout_marginBottom="@dimen/taipo_settings_gap_md">

            <TextView
                style="@style/TaipoText.Lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/backup_export_title" />

            <TextView
                style="@style/TaipoText.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_sm"
                android:text="@string/backup_export_body" />

            <Button
                style="@style/TaipoButton.Primary"
                android:id="@+id/backup_export_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_md"
                android:text="@string/backup_export_button" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="@dimen/taipo_settings_card_padding">

            <TextView
                style="@style/TaipoText.Lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/backup_restore_title" />

            <TextView
                style="@style/TaipoText.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_sm"
                android:text="@string/backup_restore_body" />

            <Button
                style="@style/TaipoButton.Secondary"
                android:id="@+id/backup_restore_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_md"
                android:text="@string/backup_restore_button" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
