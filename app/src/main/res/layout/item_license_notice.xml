<?xml version="1.0" encoding="utf-8"?>
<!-- Une mention de licence (écran « Licences ») : construite par LicensesActivity à partir de LicenseNotices. Le bouton
     de texte complet et son contenu ne sont affichés que si le fichier de licence existe dans les assets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_card"
    android:padding="@dimen/taipo_settings_card_padding"
    android:layout_marginBottom="@dimen/taipo_settings_gap_md">

    <TextView
        style="@style/TaipoText.Lead"
        android:id="@+id/license_item_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold" />

    <TextView
        style="@style/TaipoText.Caption"
        android:id="@+id/license_item_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/taipo_settings_gap_xs"
        android:textIsSelectable="true" />

    <TextView
        style="@style/TaipoText.Info"
        android:id="@+id/license_item_usage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/taipo_settings_gap_sm" />

    <TextView
        style="@style/TaipoText.Info"
        android:id="@+id/license_item_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/taipo_settings_gap_sm"
        android:textIsSelectable="true"
        android:visibility="gone" />

    <Button
        style="@style/TaipoButton.Secondary"
        android:id="@+id/license_item_project_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/taipo_settings_gap_md"
        android:text="@string/licenses_item_project_link" />

    <Button
        style="@style/TaipoButton.Secondary"
        android:id="@+id/license_item_license_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/taipo_settings_gap_sm"
        android:text="@string/licenses_item_license_link" />

    <Button
        style="@style/TaipoButton.Secondary"
        android:id="@+id/license_item_fulltext_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/taipo_settings_gap_sm"
        android:text="@string/licenses_fulltext_show"
        android:visibility="gone" />

    <TextView
        style="@style/TaipoText.Small"
        android:id="@+id/license_item_fulltext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/taipo_settings_gap_md"
        android:textIsSelectable="true"
        android:visibility="gone" />
</LinearLayout>
