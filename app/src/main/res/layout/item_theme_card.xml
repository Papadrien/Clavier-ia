<?xml version="1.0" encoding="utf-8"?>
<!-- Carte d'un thème (page « Thème », lot T5) : aperçu du clavier, coche quand la carte est choisie, libellé en dessous.
     La carte est l'élément tactile (un seul choix parmi trois) ; ThemeActivity pose le libellé, l'aperçu et l'état choisi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:padding="@dimen/taipo_settings_gap_sm"
    android:background="@drawable/bg_theme_card"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <fr.junade.taipo.ThemePreviewView
            android:id="@+id/theme_preview"
            android:layout_width="match_parent"
            android:layout_height="@dimen/taipo_theme_preview_height" />

        <ImageView
            android:id="@+id/theme_check"
            android:layout_width="@dimen/taipo_theme_check_size"
            android:layout_height="@dimen/taipo_theme_check_size"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/taipo_theme_check_margin"
            android:src="@drawable/bg_theme_check"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        style="@style/TaipoText.Body"
        android:id="@+id/theme_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/taipo_settings_gap_sm"
        android:gravity="center"
        android:textStyle="bold" />
</LinearLayout>
