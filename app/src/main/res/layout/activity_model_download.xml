<?xml version="1.0" encoding="utf-8"?>
<!-- Épopée 8 (story 8.1) : écran « Modèle IA » avec téléchargement. Les lignes (une par modèle) sont ajoutées par
     ModelDownloadActivity à partir de item_model_download. Le modèle vocal a son propre écran (activity_voice_model_download). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/taipo_settings_screen_padding">

        <TextView
            style="@style/TaipoText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/model_download_title"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm" />

        <TextView
            style="@style/TaipoText.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/model_download_description"
            android:layout_marginBottom="@dimen/taipo_settings_gap_xl" />

        <LinearLayout
            android:id="@+id/models_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Accélération du modèle (voir AiAcceleration) : GPU au choix, repli automatique sur le processeur en cas d'échec. -->
        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xl"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm"
            android:text="@string/model_gpu_section" />

        <Switch
            style="@style/TaipoSwitch"
            android:id="@+id/switch_gpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="@string/model_gpu_switch" />

        <TextView
            style="@style/TaipoText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/model_gpu_description" />

        <TextView
            style="@style/TaipoText.Caption"
            android:id="@+id/text_gpu_failed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xs"
            android:visibility="gone"
            android:text="@string/model_gpu_failed" />

    </LinearLayout>
</ScrollView>
