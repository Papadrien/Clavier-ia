<?xml version="1.0" encoding="utf-8"?>
<!-- Écran « Pack premium » (PremiumActivity) : titre, achat (bouton en haut), prix, les avantages (couleurs, consignes, modèle, presse-papiers,
     apparence, animations), ce qui reste gratuit, restauration. Pass actif : remerciement à la place des boutons d'achat. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/taipo_settings_screen_padding">

        <TextView
            style="@style/TaipoText.Title"
            android:id="@+id/premium_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/premium_title" />

        <!-- 22/11/2026 : l'achat tout en haut, sous le titre ; le message d'état (attente, erreur) juste dessous. -->
        <Button
            style="@style/TaipoButton.Primary"
            android:id="@+id/button_premium_buy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_md"
            android:text="@string/premium_buy" />
        <TextView
            style="@style/TaipoText.Info"
            android:id="@+id/premium_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_sm"
            android:visibility="gone" />

        <TextView
            style="@style/TaipoText.Display"
            android:id="@+id/premium_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_md"
            android:text="@string/premium_price_fallback" />

        <TextView
            style="@style/TaipoText.Lead"
            android:id="@+id/premium_tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xs"
            android:text="@string/premium_tagline" />

        <!-- Avantage 1 : couleurs (pastilles posées par PremiumActivity). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="@dimen/taipo_settings_card_padding"
            android:layout_marginTop="@dimen/taipo_settings_gap_xl">

            <!-- Titre de l'avantage, avec son icône (22/11/2026). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/taipo_settings_row_icon_tile"
                    android:layout_height="@dimen/taipo_settings_row_icon_tile"
                    android:layout_marginEnd="@dimen/taipo_settings_gap_md"
                    android:background="@drawable/bg_settings_row_icon"
                    android:padding="@dimen/taipo_settings_gap_sm"
                    android:src="@drawable/ic_row_theme"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/TaipoText.Section"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/premium_colors_title" />
            </LinearLayout>

            <TextView
                style="@style/TaipoText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_xs"
                android:text="@string/premium_colors_text" />

            <LinearLayout
                android:id="@+id/premium_swatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/taipo_settings_gap_md" />
        </LinearLayout>

        <!-- Avantage 2 : prompts personnalisés. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="@dimen/taipo_settings_card_padding"
            android:layout_marginTop="@dimen/taipo_settings_gap_md">

            <!-- Titre de l'avantage, avec son icône (22/11/2026). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/taipo_settings_row_icon_tile"
                    android:layout_height="@dimen/taipo_settings_row_icon_tile"
                    android:layout_marginEnd="@dimen/taipo_settings_gap_md"
                    android:background="@drawable/bg_settings_row_icon"
                    android:padding="@dimen/taipo_settings_gap_sm"
                    android:src="@drawable/ic_row_prompts"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/TaipoText.Section"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/premium_prompts_title" />
            </LinearLayout>

            <TextView
                style="@style/TaipoText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_xs"
                android:text="@string/premium_prompts_text" />

            <TextView
                style="@style/TaipoText.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_md"
                android:background="@drawable/bg_input"
                android:padding="@dimen/taipo_settings_card_padding"
                android:textStyle="italic"
                android:text="@string/premium_prompts_example" />
        </LinearLayout>

        <!-- Avantage : modèle IA personnalisé (fichier .litertlm de l'utilisateur, avec ses prompts). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="@dimen/taipo_settings_card_padding"
            android:layout_marginTop="@dimen/taipo_settings_gap_md">

            <!-- Titre de l'avantage, avec son icône (22/11/2026). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/taipo_settings_row_icon_tile"
                    android:layout_height="@dimen/taipo_settings_row_icon_tile"
                    android:layout_marginEnd="@dimen/taipo_settings_gap_md"
                    android:background="@drawable/bg_settings_row_icon"
                    android:padding="@dimen/taipo_settings_gap_sm"
                    android:src="@drawable/ic_row_custom_model"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/TaipoText.Section"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/premium_custom_model_title" />
            </LinearLayout>

            <TextView
                style="@style/TaipoText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_xs"
                android:text="@string/premium_custom_model_text" />
        </LinearLayout>

        <!-- Avantage 3 : presse-papiers étendu. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="@dimen/taipo_settings_card_padding"
            android:layout_marginTop="@dimen/taipo_settings_gap_md">

            <!-- Titre de l'avantage, avec son icône (22/11/2026). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/taipo_settings_row_icon_tile"
                    android:layout_height="@dimen/taipo_settings_row_icon_tile"
                    android:layout_marginEnd="@dimen/taipo_settings_gap_md"
                    android:background="@drawable/bg_settings_row_icon"
                    android:padding="@dimen/taipo_settings_gap_sm"
                    android:src="@drawable/ic_row_clipboard"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/TaipoText.Section"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/premium_clipboard_title" />
            </LinearLayout>

            <TextView
                style="@style/TaipoText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_xs"
                android:text="@string/premium_clipboard_text" />
        </LinearLayout>

        <!-- Avantage 4 : apparence (fonds animés, formes de touches, polices, style d'animation Gelée). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="@dimen/taipo_settings_card_padding"
            android:layout_marginTop="@dimen/taipo_settings_gap_md">

            <!-- Titre de l'avantage, avec son icône (22/11/2026). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/taipo_settings_row_icon_tile"
                    android:layout_height="@dimen/taipo_settings_row_icon_tile"
                    android:layout_marginEnd="@dimen/taipo_settings_gap_md"
                    android:background="@drawable/bg_settings_row_icon"
                    android:padding="@dimen/taipo_settings_gap_sm"
                    android:src="@drawable/ic_row_backdrop"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/TaipoText.Section"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/premium_style_title" />
            </LinearLayout>

            <TextView
                style="@style/TaipoText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_xs"
                android:text="@string/premium_style_text" />
        </LinearLayout>
        <!-- Avantage : styles d'animation (22/11/2026). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="@dimen/taipo_settings_card_padding"
            android:layout_marginTop="@dimen/taipo_settings_gap_md">
            <!-- Titre de l'avantage, avec son icône (22/11/2026). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/taipo_settings_row_icon_tile"
                    android:layout_height="@dimen/taipo_settings_row_icon_tile"
                    android:layout_marginEnd="@dimen/taipo_settings_gap_md"
                    android:background="@drawable/bg_settings_row_icon"
                    android:padding="@dimen/taipo_settings_gap_sm"
                    android:src="@drawable/ic_row_motion"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/TaipoText.Section"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/premium_motion_title" />
            </LinearLayout>
            <TextView
                style="@style/TaipoText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_xs"
                android:text="@string/premium_motion_text" />
        </LinearLayout>

        <TextView
            style="@style/TaipoText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_lg"
            android:text="@string/premium_free_reminder" />



        <Button
            style="@style/TaipoButton.Secondary"
            android:id="@+id/button_premium_restore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_sm"
            android:text="@string/premium_restore" />

        <!-- Pack actif (page de remerciement) : retour direct à l'accueil, à la place des boutons d'achat. -->
        <Button
            style="@style/TaipoButton.Primary"
            android:id="@+id/button_premium_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_lg"
            android:visibility="gone"
            android:text="@string/premium_back_home" />
    </LinearLayout>
</ScrollView>
