<?xml version="1.0" encoding="utf-8"?>
<!-- Détail d'une langue (piste C) : disposition des lettres (liste de choix), dictionnaire (état, Réessayer), retrait de la
     langue. Le titre, les choix et le bouton sont posés par LanguageDetailActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/taipo_settings_screen_padding">

        <TextView
            style="@style/TaipoText.Title"
            android:id="@+id/language_detail_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/taipo_settings_gap_xl" />

        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm"
            android:text="@string/language_detail_layout_title" />

        <LinearLayout
            android:id="@+id/language_detail_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:clipToOutline="true" />

        <!-- La carte « Dictionnaire » (état du téléchargement, Réessayer) est posée par DictionaryStatusSection. -->
        <LinearLayout
            android:id="@+id/language_detail_dictionary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xl"
            android:orientation="vertical" />

        <Button
            style="@style/TaipoButton.Secondary"
            android:id="@+id/button_language_remove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xxl"
            android:text="@string/language_detail_remove"
            android:textColor="@color/settings_warning_text" />

        <TextView
            android:id="@+id/language_detail_footer"
            style="@style/TaipoText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_sm" />
    </LinearLayout>
</ScrollView>
