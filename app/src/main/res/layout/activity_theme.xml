<?xml version="1.0" encoding="utf-8"?>
<!-- Page « Thème » (lot T5) : cartes d'aperçu (Système, Clair, Sombre, et Couleur dynamique dès Android 12) posées par ThemeActivity, par rangées de trois, sans texte d'explication.
     Section « Couleur » : pastilles des couleurs d'accent (AccentPalette), posées par ThemeActivity par rangées de cinq ; prévue pour le pass premium. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/taipo_settings_screen_padding">

        <TextView
            style="@style/TaipoText.Title"
            android:id="@+id/theme_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/taipo_settings_gap_xl"
            android:text="@string/theme_title" />

        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm"
            android:text="@string/theme_section_keyboard" />

        <LinearLayout
            android:id="@+id/theme_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/TaipoText.Section"
            android:id="@+id/theme_color_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xxl"
            android:layout_marginBottom="@dimen/taipo_settings_gap_md"
            android:text="@string/theme_section_color" />

        <LinearLayout
            android:id="@+id/theme_palettes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Couleur réservée touchée sans pass : elle est montrée sur les aperçus, ce bouton ouvre l'écran du pass. -->
        <Button
            style="@style/TaipoButton.Primary"
            android:id="@+id/button_theme_unlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_md"
            android:text="@string/premium_unlock"
            android:visibility="gone" />

        <TextView
            style="@style/TaipoText.Section"
            android:id="@+id/theme_font_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xxl"
            android:layout_marginBottom="@dimen/taipo_settings_gap_xs"
            android:text="@string/theme_section_font" />

        <TextView
            style="@style/TaipoText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/taipo_settings_gap_md"
            android:text="@string/theme_font_description" />

        <!-- Une ligne par police (ThemeActivity.buildFonts), chacune écrite dans sa police. -->
        <LinearLayout
            android:id="@+id/theme_fonts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:clipToOutline="true" />

        <!-- Police réservée touchée sans pass : son exemple reste affiché, ce bouton ouvre l'écran du pass. -->
        <Button
            style="@style/TaipoButton.Primary"
            android:id="@+id/button_font_unlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_md"
            android:text="@string/premium_unlock"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
