<?xml version="1.0" encoding="utf-8"?>
<!-- Page « Thème » (lot T5) : cartes d'aperçu (Système, Clair, Sombre, et Couleur dynamique dès Android 12) posées par ThemeActivity, par rangées de trois, sans texte d'explication.
     Section « Couleur » : pastilles des couleurs d'accent (AccentPalette), posées par ThemeActivity par rangées de cinq ; prévue pour le pass premium.
     Section « Forme des touches » : cartes des formes de touches (KeyShape), par rangées de trois. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/theme_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/taipo_settings_screen_padding">

        <TextView
            style="@style/TaipoText.Title"
            android:id="@+id/theme_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/taipo_settings_gap_xl"
            android:text="@string/theme_title" />

        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm"
            android:text="@string/theme_section_keyboard" />

        <LinearLayout
            android:id="@+id/theme_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/TaipoText.Section"
            android:id="@+id/theme_color_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xxl"
            android:layout_marginBottom="@dimen/taipo_settings_gap_md"
            android:text="@string/theme_section_color" />

        <LinearLayout
            android:id="@+id/theme_palettes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Couleur réservée touchée sans pass : elle est montrée sur les aperçus, ce bouton ouvre l'écran du pass. -->
        <Button
            style="@style/TaipoButton.Primary"
            android:id="@+id/button_theme_unlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_md"
            android:text="@string/premium_unlock"
            android:visibility="gone" />

        <!-- Section « Forme des touches » : une carte par forme (KeyShape), posées par ThemeActivity par rangées de trois. Les formes
             réservées au pass portent un cadenas ; touchée sans pass, une forme est montrée sur les aperçus et ce bouton ouvre le pass. -->
        <TextView
            style="@style/TaipoText.Section"
            android:id="@+id/theme_shape_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xxl"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm"
            android:text="@string/theme_section_shape" />

        <LinearLayout
            android:id="@+id/theme_shapes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            style="@style/TaipoButton.Primary"
            android:id="@+id/button_shape_unlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_md"
            android:text="@string/premium_unlock"
            android:visibility="gone" />

        <TextView
            style="@style/TaipoText.Section"
            android:id="@+id/theme_backdrop_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xxl"
            android:layout_marginBottom="@dimen/taipo_settings_gap_md"
            android:text="@string/theme_section_backdrop" />

        <!-- Une vignette par fond (ThemeActivity.buildBackdrops), par rangées de deux ; les motifs avancent au défilement. -->
        <LinearLayout
            android:id="@+id/theme_backdrops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Switch
            android:id="@+id/switch_backdrop_animated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_md"
            android:textStyle="bold"
            android:text="@string/theme_backdrop_animated" />

        <TextView
            style="@style/TaipoText.Caption"
            android:id="@+id/text_backdrop_animated_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_backdrop_animated_description" />

        <Button
            style="@style/TaipoButton.Secondary"
            android:id="@+id/button_backdrop_reseed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_md"
            android:text="@string/theme_backdrop_reseed" />

        <!-- Motif touché sans pass : il reste sélectionné à l'écran, ce bouton ouvre l'écran du pass. -->
        <Button
            style="@style/TaipoButton.Primary"
            android:id="@+id/button_backdrop_unlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_md"
            android:text="@string/premium_unlock"
            android:visibility="gone" />

        <TextView
            style="@style/TaipoText.Section"
            android:id="@+id/theme_font_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xxl"
            android:layout_marginBottom="@dimen/taipo_settings_gap_xs"
            android:text="@string/theme_section_font" />

        <TextView
            style="@style/TaipoText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/taipo_settings_gap_md"
            android:text="@string/theme_font_description" />

        <!-- Une ligne par police (ThemeActivity.buildFonts), chacune écrite dans sa police. -->
        <LinearLayout
            android:id="@+id/theme_fonts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:clipToOutline="true" />

        <!-- Police réservée touchée sans pass : son exemple reste affiché, ce bouton ouvre l'écran du pass. -->
        <Button
            style="@style/TaipoButton.Primary"
            android:id="@+id/button_font_unlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_md"
            android:text="@string/premium_unlock"
            android:visibility="gone" />

        <!-- Section « Animations » : une carte par style (MotionStyle), aperçu animé en boucle, posées par ThemeActivity par
             rangées de trois. Gelée, réservée au pack, porte un cadenas ; touchée sans pack, ce bouton ouvre l'écran du pack. -->
        <TextView
            style="@style/TaipoText.Section"
            android:id="@+id/theme_motion_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xxl"
            android:text="@string/theme_section_motion" />

        <TextView
            style="@style/TaipoText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm"
            android:text="@string/theme_motion_caption" />

        <LinearLayout
            android:id="@+id/theme_motions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false" />

        <Button
            style="@style/TaipoButton.Primary"
            android:id="@+id/button_motion_unlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_md"
            android:text="@string/premium_unlock"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
