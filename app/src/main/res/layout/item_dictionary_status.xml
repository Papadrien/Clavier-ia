<?xml version="1.0" encoding="utf-8"?>
<!-- Ligne d'un dictionnaire dans les paramètres du clavier : langue, état du téléchargement, bouton Réessayer / Télécharger.
     Posée par DictionaryStatusSection. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_card"
    android:padding="@dimen/taipo_settings_card_padding"
    android:layout_marginTop="@dimen/taipo_settings_gap_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TaipoText.Lead"
                android:id="@+id/dictionary_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold" />

            <TextView
                style="@style/TaipoText.Info"
                android:id="@+id/dictionary_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_xs" />
        </LinearLayout>

        <Button
            style="@style/TaipoButton.Secondary"
            android:id="@+id/dictionary_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/taipo_settings_gap_sm"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:id="@+id/dictionary_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/taipo_settings_gap_sm"
        android:max="100"
        android:visibility="gone" />
</LinearLayout>
