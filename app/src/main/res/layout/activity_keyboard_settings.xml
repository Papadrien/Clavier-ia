<?xml version="1.0" encoding="utf-8"?>
<!-- Paramètres du clavier (v3) : un titre de section au-dessus de chaque carte, comme l'accueil. Ordre : Langues,
     Disposition des touches, Taille et position, Sons et vibrations, Saisie intelligente, puis le lien Confidentialité.
     Les choix à quelques valeurs (hauteur, mode une main, vibrations) sont des sélecteurs segmentés (TaipoSegment).
     La carte « Précision de frappe » n'est visible qu'en debug (KeyboardSettingsActivity). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/taipo_settings_screen_padding">

        <TextView
            style="@style/TaipoText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_settings_title" />

        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_lg"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm"
            android:text="@string/languages_title" />

        <!-- Une ligne vers l'écran « Langues » (liste des langues, disposition et dictionnaire de chacune) ; résumé posé par KeyboardSettingsActivity. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_card"
            android:clipToOutline="true">

            <include
                android:id="@+id/button_languages"
                layout="@layout/view_settings_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xl"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm"
            android:text="@string/keyboard_settings_layout_title" />

        <LinearLayout
            style="@style/TaipoSettingsCard">

            <Switch
                android:id="@+id/switch_number_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/keyboard_settings_number_row" />

            <Switch
                android:id="@+id/switch_number_row_passwords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/keyboard_settings_number_row_passwords" />

            <View style="@style/TaipoSettingsCardDivider" />

            <TextView
                style="@style/TaipoText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_bottom_row_title" />

            <Switch
                android:id="@+id/switch_show_emoji_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/keyboard_settings_show_emoji_key" />

            <Switch
                android:id="@+id/switch_show_comma_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/keyboard_settings_show_comma_key" />

            <Switch
                android:id="@+id/switch_show_period_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/keyboard_settings_show_period_key" />
        </LinearLayout>

        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xl"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm"
            android:text="@string/keyboard_settings_size_title" />

        <LinearLayout
            style="@style/TaipoSettingsCard">

            <TextView
                style="@style/TaipoText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_height_title" />

            <RadioGroup
                android:id="@+id/radio_group_height"
                style="@style/TaipoSegmentedGroup">

                <RadioButton
                    android:id="@+id/radio_height_compact"
                    style="@style/TaipoSegment"
                    android:contentDescription="@string/keyboard_settings_height_compact"
                    android:text="@string/keyboard_settings_height_compact_short" />

                <RadioButton
                    android:id="@+id/radio_height_small"
                    style="@style/TaipoSegment"
                    android:contentDescription="@string/keyboard_settings_height_small"
                    android:text="@string/keyboard_settings_height_small_short" />

                <RadioButton
                    android:id="@+id/radio_height_normal"
                    style="@style/TaipoSegment"
                    android:contentDescription="@string/keyboard_settings_height_normal"
                    android:text="@string/keyboard_settings_height_normal_short" />

                <RadioButton
                    android:id="@+id/radio_height_large"
                    style="@style/TaipoSegment"
                    android:contentDescription="@string/keyboard_settings_height_large"
                    android:text="@string/keyboard_settings_height_large_short" />

                <RadioButton
                    android:id="@+id/radio_height_extra_large"
                    style="@style/TaipoSegment"
                    android:contentDescription="@string/keyboard_settings_height_extra_large"
                    android:text="@string/keyboard_settings_height_extra_large_short" />
            </RadioGroup>

            <View style="@style/TaipoSettingsCardDivider" />

            <TextView
                style="@style/TaipoText.Label"
                android:id="@+id/text_bottom_margin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <SeekBar
                android:id="@+id/seek_bottom_margin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_xs"
                android:minHeight="@dimen/taipo_settings_row_min_height"
                android:contentDescription="@string/keyboard_settings_bottom_margin" />

            <View style="@style/TaipoSettingsCardDivider" />

            <TextView
                style="@style/TaipoText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_mode_title" />

            <!-- Mode du clavier : normal, une main (à gauche, à droite) ou flottant ; un seul à la fois. -->
            <RadioGroup
                android:id="@+id/radio_group_keyboard_mode"
                style="@style/TaipoSegmentedGroup">

                <RadioButton
                    android:id="@+id/radio_mode_normal"
                    style="@style/TaipoSegment"
                    android:text="@string/keyboard_settings_mode_normal" />

                <RadioButton
                    android:id="@+id/radio_mode_left"
                    style="@style/TaipoSegment"
                    android:contentDescription="@string/keyboard_settings_mode_left_description"
                    android:text="@string/keyboard_settings_mode_left" />

                <RadioButton
                    android:id="@+id/radio_mode_right"
                    style="@style/TaipoSegment"
                    android:contentDescription="@string/keyboard_settings_mode_right_description"
                    android:text="@string/keyboard_settings_mode_right" />

                <RadioButton
                    android:id="@+id/radio_mode_floating"
                    style="@style/TaipoSegment"
                    android:contentDescription="@string/keyboard_settings_mode_floating_description"
                    android:text="@string/keyboard_settings_mode_floating" />
            </RadioGroup>

            <TextView
                style="@style/TaipoText.Label"
                android:id="@+id/text_one_handed_width"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_sm" />

            <SeekBar
                android:id="@+id/seek_one_handed_width"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_xs"
                android:minHeight="@dimen/taipo_settings_row_min_height"
                android:contentDescription="@string/keyboard_settings_one_handed_width" />

            <TextView
                style="@style/TaipoText.Label"
                android:id="@+id/text_floating_width"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_sm" />

            <SeekBar
                android:id="@+id/seek_floating_width"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_xs"
                android:minHeight="@dimen/taipo_settings_row_min_height"
                android:contentDescription="@string/keyboard_settings_floating_width" />

            <TextView
                style="@style/TaipoText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_one_handed_hint" />
        </LinearLayout>

        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xl"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm"
            android:text="@string/keyboard_settings_sounds_title" />

        <LinearLayout
            style="@style/TaipoSettingsCard">

            <TextView
                style="@style/TaipoText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_haptic_title" />

            <RadioGroup
                android:id="@+id/radio_group_haptic"
                style="@style/TaipoSegmentedGroup">

                <RadioButton
                    android:id="@+id/radio_haptic_off"
                    style="@style/TaipoSegment"
                    android:contentDescription="@string/keyboard_settings_haptic_off"
                    android:text="@string/keyboard_settings_haptic_off_short" />

                <RadioButton
                    android:id="@+id/radio_haptic_light"
                    style="@style/TaipoSegment"
                    android:text="@string/keyboard_settings_haptic_light" />

                <RadioButton
                    android:id="@+id/radio_haptic_medium"
                    style="@style/TaipoSegment"
                    android:text="@string/keyboard_settings_haptic_medium" />

                <RadioButton
                    android:id="@+id/radio_haptic_strong"
                    style="@style/TaipoSegment"
                    android:text="@string/keyboard_settings_haptic_strong" />
            </RadioGroup>

            <View style="@style/TaipoSettingsCardDivider" />

            <Switch
                android:id="@+id/switch_key_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/keyboard_settings_key_sound" />

            <Switch
                android:id="@+id/switch_bar_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/keyboard_settings_bar_sound" />

            <!-- Volume : affiché seulement si l'un des deux sons est activé (KeyboardSettingsActivity.updateVolumeVisibility). -->
            <LinearLayout
                android:id="@+id/group_sound_volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/taipo_settings_gap_sm">

                <TextView
                    style="@style/TaipoText.Label"
                    android:id="@+id/text_sound_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <SeekBar
                    android:id="@+id/seek_sound_volume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/taipo_settings_gap_xs"
                    android:minHeight="@dimen/taipo_settings_row_min_height"
                    android:contentDescription="@string/keyboard_settings_sound_volume" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xl"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm"
            android:text="@string/keyboard_settings_smart_title" />

        <LinearLayout
            style="@style/TaipoSettingsCard">

            <Switch
                android:id="@+id/switch_habit_learning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/keyboard_settings_habits_switch" />

            <TextView
                style="@style/TaipoText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_habits_description" />

            <Button
                android:id="@+id/button_habit_clear"
                style="@style/TaipoButton.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_md"
                android:text="@string/keyboard_settings_habits_clear" />

            <View style="@style/TaipoSettingsCardDivider" />

            <Switch
                android:id="@+id/switch_clipboard_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/keyboard_settings_clipboard_history_switch" />

            <TextView
                style="@style/TaipoText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_clipboard_history_description" />

            <View style="@style/TaipoSettingsCardDivider" />

            <Switch
                android:id="@+id/switch_screenshot_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/keyboard_settings_screenshots_switch" />

            <TextView
                style="@style/TaipoText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_screenshots_description" />
        </LinearLayout>

        <!-- Builds debug seulement : réglages en cours de validation (masqués en release par KeyboardSettingsActivity). -->
        <LinearLayout
            android:id="@+id/group_touch_precision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/TaipoText.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_xl"
                android:layout_marginBottom="@dimen/taipo_settings_gap_sm"
                android:text="@string/keyboard_settings_touch_title" />

            <LinearLayout
                style="@style/TaipoSettingsCard">

                <Switch
                    android:id="@+id/switch_adaptive_touch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="@string/keyboard_settings_touch_switch" />

                <TextView
                    style="@style/TaipoText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keyboard_settings_touch_description" />

                <Switch
                    android:id="@+id/switch_touch_zones_debug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="@string/keyboard_settings_touch_zones_debug" />
            </LinearLayout>
        </LinearLayout>

        <!-- Revue UX : le détail de ce que le clavier garde est dans la page Confidentialité (section 6) ; les données
             d'utilisation se règlent dans « Mes données », sur l'accueil. -->
        <TextView
            style="@style/TaipoText.Body"
            android:id="@+id/link_privacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xl"
            android:minHeight="@dimen/taipo_settings_row_min_height"
            android:gravity="center_vertical"
            android:textColor="@color/taipo_purple_light"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground"
            android:text="@string/keyboard_settings_privacy_link" />

    </LinearLayout>
</ScrollView>
