<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/taipo_settings_screen_padding">

        <TextView
            style="@style/TaipoText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_settings_title"
            android:layout_marginBottom="@dimen/taipo_settings_gap_lg" />

        <Switch
            android:id="@+id/switch_number_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_settings_number_row" />

        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_settings_language_title"
            android:layout_marginTop="@dimen/taipo_settings_gap_xxl"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm" />

        <!-- Liste déroulante (Automatique + une langue) remplie par KeyboardSettingsActivity. -->
        <Spinner
            android:id="@+id/spinner_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Switch
            android:id="@+id/switch_multilingual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_sm"
            android:text="@string/keyboard_settings_multilingual_switch" />

        <!-- Une case par langue, remplie par KeyboardSettingsActivity ; visible seulement si le mode est activé. -->
        <LinearLayout
            android:id="@+id/layout_multilingual_languages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_multilingual_min"
            style="@style/TaipoText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_settings_multilingual_min"
            android:layout_marginTop="@dimen/taipo_settings_gap_xs"
            android:visibility="gone" />

        <TextView
            style="@style/TaipoText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_settings_multilingual_description"
            android:layout_marginTop="@dimen/taipo_settings_gap_xs" />

        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_settings_dictionaries_title"
            android:layout_marginTop="@dimen/taipo_settings_gap_xxl" />

        <!-- Une ligne par langue utilisée, remplie par DictionaryStatusSection. -->
        <LinearLayout
            android:id="@+id/layout_dictionaries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_settings_haptic_title"
            android:layout_marginTop="@dimen/taipo_settings_gap_xxl"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm" />

        <RadioGroup
            android:id="@+id/radio_group_haptic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_haptic_off"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_haptic_off" />

            <RadioButton
                android:id="@+id/radio_haptic_light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_haptic_light" />

            <RadioButton
                android:id="@+id/radio_haptic_medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_haptic_medium" />

            <RadioButton
                android:id="@+id/radio_haptic_strong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_haptic_strong" />

        </RadioGroup>

        <Switch
            android:id="@+id/switch_key_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_lg"
            android:text="@string/keyboard_settings_key_sound" />

        <Switch
            android:id="@+id/switch_bar_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_lg"
            android:text="@string/keyboard_settings_bar_sound" />

        <TextView
            android:id="@+id/text_sound_volume"
            style="@style/TaipoText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_lg" />

        <SeekBar
            android:id="@+id/seek_sound_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xs"
            android:max="100"
            android:contentDescription="@string/keyboard_settings_sound_volume" />

        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_settings_height_title"
            android:layout_marginTop="@dimen/taipo_settings_gap_xxl"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm" />

        <RadioGroup
            android:id="@+id/radio_group_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_height_compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_height_compact" />

            <RadioButton
                android:id="@+id/radio_height_small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_height_small" />

            <RadioButton
                android:id="@+id/radio_height_normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_height_normal" />

            <RadioButton
                android:id="@+id/radio_height_large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_height_large" />

            <RadioButton
                android:id="@+id/radio_height_extra_large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_height_extra_large" />

        </RadioGroup>

        <TextView
            android:id="@+id/text_bottom_margin"
            style="@style/TaipoText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_lg" />

        <SeekBar
            android:id="@+id/seek_bottom_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xs"
            android:max="100"
            android:contentDescription="@string/keyboard_settings_bottom_margin" />

        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_settings_habits_title"
            android:layout_marginTop="@dimen/taipo_settings_gap_xxl"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm" />

        <Switch
            android:id="@+id/switch_habit_learning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_settings_habits_switch" />

        <TextView
            style="@style/TaipoText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_settings_habits_description"
            android:layout_marginTop="@dimen/taipo_settings_gap_xs" />

        <Button
            android:id="@+id/button_habit_clear"
            style="@style/TaipoButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_settings_habits_clear"
            android:layout_marginTop="@dimen/taipo_settings_gap_md" />

        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_settings_analytics_title"
            android:layout_marginTop="@dimen/taipo_settings_gap_xxl"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm" />

        <Switch
            android:id="@+id/switch_analytics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_settings_analytics_switch" />

        <TextView
            style="@style/TaipoText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_settings_analytics_description"
            android:layout_marginTop="@dimen/taipo_settings_gap_xs" />

    </LinearLayout>
</ScrollView>
