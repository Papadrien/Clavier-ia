<?xml version="1.0" encoding="utf-8"?>
<!-- Story 8.15 : écran « Modèle vocal » avec téléchargement, séparé de l'écran « Modèle IA ». La ligne du modèle est ajoutée
     par VoiceModelDownloadActivity à partir de item_model_download. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/taipo_settings_screen_padding">

        <TextView
            style="@style/TaipoText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/model_download_voice_section_title"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm" />

        <LinearLayout
            android:id="@+id/voice_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
