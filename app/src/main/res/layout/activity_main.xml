<?xml version="1.0" encoding="utf-8"?>
<!-- Lot 19 : l'écran défile (paysage, petit téléphone, polices agrandies : le contenu dépasse la hauteur de l'écran). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="@dimen/taipo_settings_screen_padding">

    <!-- Lot UX 1 : logo horizontal en tête de l'accueil (image décorative de marque : le titre juste dessous porte le sens,
         mais le nom « Taipo » reste annoncé par TalkBack via la description). Largeur plafonnée pour les tablettes. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/taipo_home_logo_max_width"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/taipo_logo_horizontal"
        android:contentDescription="@string/app_name"
        android:layout_marginBottom="@dimen/taipo_settings_gap_xl" />

    <TextView
        style="@style/TaipoText.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/main_title"
        android:layout_marginBottom="@dimen/taipo_settings_gap_xxl" />

    <LinearLayout
        android:id="@+id/step1_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_settings_card"
        android:padding="@dimen/taipo_settings_card_padding"
        android:layout_marginBottom="@dimen/taipo_settings_gap_md">

        <TextView
            android:id="@+id/step1_badge"
            android:layout_width="@dimen/taipo_step_badge_size"
            android:layout_height="@dimen/taipo_step_badge_size"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="@dimen/taipo_settings_text_caption"
            android:textColor="@color/text_primary"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/taipo_settings_gap_md"
            android:orientation="vertical">

            <TextView
                style="@style/TaipoText.Section"
                android:id="@+id/step1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/TaipoText.Caption"
                android:id="@+id/step1_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_xs" />

            <Button
                style="@style/TaipoButton.Primary"
                android:id="@+id/button_enable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_md"
                android:text="@string/button_enable" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/step2_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_settings_card"
        android:padding="@dimen/taipo_settings_card_padding"
        android:layout_marginBottom="@dimen/taipo_settings_gap_md">

        <TextView
            android:id="@+id/step2_badge"
            android:layout_width="@dimen/taipo_step_badge_size"
            android:layout_height="@dimen/taipo_step_badge_size"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="@dimen/taipo_settings_text_caption"
            android:textColor="@color/text_primary"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/taipo_settings_gap_md"
            android:orientation="vertical">

            <TextView
                style="@style/TaipoText.Section"
                android:id="@+id/step2_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/TaipoText.Caption"
                android:id="@+id/step2_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_xs" />

            <Button
                style="@style/TaipoButton.Primary"
                android:id="@+id/button_select"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_md"
                android:text="@string/button_select" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/step3_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_settings_card"
        android:padding="@dimen/taipo_settings_card_padding"
        android:layout_marginBottom="@dimen/taipo_settings_gap_md">

        <TextView
            android:id="@+id/step3_badge"
            android:layout_width="@dimen/taipo_step_badge_size"
            android:layout_height="@dimen/taipo_step_badge_size"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="@dimen/taipo_settings_text_caption"
            android:textColor="@color/text_primary"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/taipo_settings_gap_md"
            android:orientation="vertical">

            <TextView
                style="@style/TaipoText.Section"
                android:id="@+id/step3_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/TaipoText.Caption"
                android:id="@+id/step3_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_xs" />

            <EditText
                style="@style/TaipoInput"
                android:id="@+id/onboarding_try_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_md"
                android:hint="@string/onboarding_try_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:gravity="top|start" />
        </LinearLayout>
    </LinearLayout>

    <!-- Étape 4 : activer l'IA (télécharger un modèle) ; le bouton ouvre l'écran « Modèle IA » avec le modèle recommandé. -->
    <LinearLayout
        android:id="@+id/step4_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_settings_card"
        android:padding="@dimen/taipo_settings_card_padding"
        android:layout_marginBottom="@dimen/taipo_settings_gap_md">

        <TextView
            android:id="@+id/step4_badge"
            android:layout_width="@dimen/taipo_step_badge_size"
            android:layout_height="@dimen/taipo_step_badge_size"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="@dimen/taipo_settings_text_caption"
            android:textColor="@color/text_primary"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/taipo_settings_gap_md"
            android:orientation="vertical">

            <TextView
                style="@style/TaipoText.Section"
                android:id="@+id/step4_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/TaipoText.Caption"
                android:id="@+id/step4_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_xs" />

            <Button
                style="@style/TaipoButton.Primary"
                android:id="@+id/button_activate_ai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_md" />
        </LinearLayout>
    </LinearLayout>

    <!-- Étape 5 : activer la dictée (télécharger le modèle vocal) ; le bouton ouvre l'écran « Modèle vocal ». -->
    <LinearLayout
        android:id="@+id/step5_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_settings_card"
        android:padding="@dimen/taipo_settings_card_padding"
        android:layout_marginBottom="@dimen/taipo_settings_gap_xl">

        <TextView
            android:id="@+id/step5_badge"
            android:layout_width="@dimen/taipo_step_badge_size"
            android:layout_height="@dimen/taipo_step_badge_size"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="@dimen/taipo_settings_text_caption"
            android:textColor="@color/text_primary"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/taipo_settings_gap_md"
            android:orientation="vertical">

            <TextView
                style="@style/TaipoText.Section"
                android:id="@+id/step5_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/TaipoText.Caption"
                android:id="@+id/step5_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_xs" />

            <Button
                style="@style/TaipoButton.Primary"
                android:id="@+id/button_activate_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/taipo_settings_gap_md" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pass premium : carte d'offre, montrée une fois les 3 étapes faites, tant que le pass n'est pas actif et qu'elle n'a pas
         été masquée (MainActivity.renderPremium). Le pass reste accessible par la ligne « Pass premium » de « À propos ». -->
    <!-- Audit PRIV-01 : accord explicite pour la mesure d'usage, tant que l'utilisateur n'a pas répondu. -->
    <LinearLayout
        android:id="@+id/analytics_consent_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_settings_card"
        android:padding="@dimen/taipo_settings_card_padding"
        android:layout_marginBottom="@dimen/taipo_settings_gap_xl"
        android:visibility="gone">

        <TextView
            style="@style/TaipoText.Section"
            android:id="@+id/analytics_consent_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_analytics_consent_title" />

        <TextView
            style="@style/TaipoText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_analytics_consent_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/taipo_settings_gap_md">

            <Button
                style="@style/TaipoButton.Secondary"
                android:id="@+id/button_analytics_refuse"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/taipo_settings_gap_sm"
                android:text="@string/home_analytics_consent_refuse" />

            <Button
                style="@style/TaipoButton.Primary"
                android:id="@+id/button_analytics_accept"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_analytics_consent_accept" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/premium_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_theme_card"
        android:padding="@dimen/taipo_settings_card_padding"
        android:layout_marginBottom="@dimen/taipo_settings_gap_xl"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/TaipoText.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_premium_card_title" />

            <ImageButton
                android:id="@+id/button_premium_card_close"
                android:layout_width="@dimen/taipo_settings_row_min_height"
                android:layout_height="@dimen/taipo_settings_row_min_height"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/home_premium_card_close" />
        </LinearLayout>

        <TextView
            style="@style/TaipoText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_premium_card_text" />

        <Button
            style="@style/TaipoButton.Primary"
            android:id="@+id/button_premium_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_md"
            android:text="@string/home_premium_card_button" />
    </LinearLayout>

    <TextView
        style="@style/TaipoText.Section"
        android:id="@+id/section_keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_section_keyboard"
        android:layout_marginBottom="@dimen/taipo_settings_gap_sm" />

    <!-- clipToOutline : les retours visuels des lignes suivent les coins arrondis de la carte. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_settings_card"
        android:clipToOutline="true"
        android:layout_marginBottom="@dimen/taipo_settings_gap_xl">

        <include
            android:id="@+id/button_keyboard_settings"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/taipo_settings_divider_thickness"
            android:layout_marginStart="@dimen/taipo_settings_card_padding"
            android:background="@color/settings_divider" />

        <!-- Revue UX : les langues sur l'accueil, sous-titre = langues en service (MainActivity.renderLanguagesRow). -->
        <include
            android:id="@+id/button_home_languages"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/taipo_settings_divider_thickness"
            android:layout_marginStart="@dimen/taipo_settings_card_padding"
            android:background="@color/settings_divider" />

        <!-- Page « Thème » (lot T5) : le sous-titre montre le thème choisi (MainActivity.renderThemeRow). -->
        <include
            android:id="@+id/button_theme"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/taipo_settings_divider_thickness"
            android:layout_marginStart="@dimen/taipo_settings_card_padding"
            android:background="@color/settings_divider" />

        <include
            android:id="@+id/button_personal_dictionary"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        style="@style/TaipoText.Section"
        android:id="@+id/section_ai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_section_ai"
        android:layout_marginBottom="@dimen/taipo_settings_gap_sm" />

    <!-- clipToOutline : les retours visuels des lignes suivent les coins arrondis de la carte. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_settings_card"
        android:clipToOutline="true"
        android:layout_marginBottom="@dimen/taipo_settings_gap_sm">

        <include
            android:id="@+id/button_model_download"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Story 8.12 : ce séparateur et la ligne « Modèle IA local » ne sont visibles qu'en build debug (MainActivity). -->
        <View
            android:id="@+id/divider_model_settings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/taipo_settings_divider_thickness"
            android:layout_marginStart="@dimen/taipo_settings_card_padding"
            android:background="@color/settings_divider" />

        <include
            android:id="@+id/button_model_settings"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/taipo_settings_divider_thickness"
            android:layout_marginStart="@dimen/taipo_settings_card_padding"
            android:background="@color/settings_divider" />

        <include
            android:id="@+id/button_voice_model_settings"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Story 8.15 : ce séparateur et la ligne « Modèle vocal local » ne sont visibles qu'en build debug (MainActivity). -->
        <View
            android:id="@+id/divider_voice_model_local"
            android:layout_width="match_parent"
            android:layout_height="@dimen/taipo_settings_divider_thickness"
            android:layout_marginStart="@dimen/taipo_settings_card_padding"
            android:background="@color/settings_divider" />

        <include
            android:id="@+id/button_voice_model_local"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/taipo_settings_divider_thickness"
            android:layout_marginStart="@dimen/taipo_settings_card_padding"
            android:background="@color/settings_divider" />

        <include
            android:id="@+id/button_system_prompts"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        style="@style/TaipoText.Section"
        android:id="@+id/section_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_section_data"
        android:layout_marginTop="@dimen/taipo_settings_gap_xl"
        android:layout_marginBottom="@dimen/taipo_settings_gap_sm" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_settings_card"
        android:clipToOutline="true">

        <include
            android:id="@+id/button_backup"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/taipo_settings_divider_thickness"
            android:layout_marginStart="@dimen/taipo_settings_card_padding"
            android:background="@color/settings_divider" />

        <!-- Revue UX : les données d'utilisation (Aptabase) se règlent ici, à côté de la sauvegarde. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/taipo_settings_card_padding"
            android:paddingEnd="@dimen/taipo_settings_card_padding"
            android:paddingTop="@dimen/taipo_settings_gap_sm"
            android:paddingBottom="@dimen/taipo_settings_gap_md">

            <Switch
                style="@style/TaipoSwitch"
                android:id="@+id/switch_analytics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/keyboard_settings_analytics_switch" />

            <TextView
                style="@style/TaipoText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_settings_analytics_description" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/TaipoText.Section"
        android:id="@+id/section_about"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_section_about"
        android:layout_marginTop="@dimen/taipo_settings_gap_xl"
        android:layout_marginBottom="@dimen/taipo_settings_gap_sm" />

    <!-- Pass premium : sa propre carte, encadrée de violet, en tête de « À propos ». -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_settings_card_premium"
        android:clipToOutline="true"
        android:layout_marginBottom="@dimen/taipo_settings_gap_sm">

        <include
            android:id="@+id/button_premium"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_settings_card"
        android:clipToOutline="true">

        <include
            android:id="@+id/button_terms"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/taipo_settings_divider_thickness"
            android:layout_marginStart="@dimen/taipo_settings_card_padding"
            android:background="@color/settings_divider" />

        <include
            android:id="@+id/button_licenses"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/taipo_settings_divider_thickness"
            android:layout_marginStart="@dimen/taipo_settings_card_padding"
            android:background="@color/settings_divider" />

        <include
            android:id="@+id/button_privacy"
            layout="@layout/view_settings_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Builds debug seulement (MainActivity) : forçage du pass premium, pour tester les deux états sans achat. -->
    <LinearLayout
        android:id="@+id/debug_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/taipo_settings_gap_xl"
        android:visibility="gone">

        <TextView
            style="@style/TaipoText.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/taipo_settings_gap_sm"
            android:text="@string/home_section_debug" />

        <Button
            style="@style/TaipoButton.Secondary"
            android:id="@+id/button_debug_premium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/TaipoText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_xs"
            android:text="@string/home_debug_premium_hint" />

        <Button
            style="@style/TaipoButton.Secondary"
            android:id="@+id/button_debug_diagnostic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/taipo_settings_gap_md"
            android:text="@string/home_debug_diagnostic" />

        <Button
            style="@style/TaipoButton.Secondary"
            android:id="@+id/button_debug_reset_tips"
