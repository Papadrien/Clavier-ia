<?xml version="1.0" encoding="utf-8"?>
<!-- PALETTE SOMBRE : le thème de la V1 (toujours utilisé, voir KeyboardTheme). Les valeurs sont celles
     d'origine du clavier ; la palette claire (V2) est dans values/colors.xml. -->
<resources>
    <color name="accent">#5A7FD4</color>

    <!-- Texte principal et icônes. -->
    <color name="text_primary">#FFFFFF</color>

    <!-- Clavier (KeyboardView). -->
    <color name="keyboard_background">#FF000000</color>
    <color name="key_normal">#2E2E2E</color>
    <color name="key_functional">#141414</color>
    <color name="key_pressed">#4A4A4A</color>
    <color name="key_enter">#80CBC4</color>
    <color name="key_label">#E0E0E0</color>
    <color name="key_popup">#3A3A3A</color>
    <color name="key_popup_selection">#26A69A</color>
    <color name="key_hint">#9E9E9E</color>

    <!-- Barre du haut, prompt, bande de suggestions, zone de chat. -->
    <color name="surface_button">#3A3F47</color>
    <color name="surface_pill">#2A2D33</color>
    <color name="text_hint">#8A9099</color>
    <color name="action_send">#2FA37A</color>
    <color name="action_danger">#C0392B</color>

    <!-- Smart Clipboard. -->
    <color name="clip_text_muted">#9AA0A6</color>
    <color name="clip_item">#1E2025</color>
    <color name="clip_item_pinned">#22304A</color>
    <color name="clip_pin_badge">#3F5F9E</color>
    <color name="clip_dialog">#2B2F36</color>
    <color name="clip_danger_text">#FF8A80</color>
    <color name="scrim">#99000000</color>

    <!-- Écrans de réglages. -->
    <color name="settings_card">#2A2D33</color>
    <color name="settings_divider">#3A3F47</color>
    <color name="settings_warning_text">#FFB38A</color>
</resources>
