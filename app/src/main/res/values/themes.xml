<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Open Sans (lot 02) : police par défaut des composants standards. Les vues du clavier la posent
         explicitement (voir TaipoType), car elles ne reçoivent pas ce thème. -->
    <!-- Écrans de l'application : même thème que le clavier (ThemeChoice, page « Apparence » ; « Système » par défaut), posé par
         KeyboardTheme.wrap. Les couleurs viennent des deux palettes (values/ et values-night/colors.xml) ; seuls les thèmes
         Android de base diffèrent (Platform.*, clair ici, sombre dans values-night/themes.xml). forceDarkAllowed=false : le
         système n'a pas à réassombrir lui-même les écrans. -->

    <!-- Pas de barre d'action framework : chaque écran affiche déjà son propre titre dans la page,
         et la barre d'action se superposait au contenu en mode bord à bord. -->
    <style name="AppTheme" parent="Platform.AppTheme">
        <!-- Lot 16 : fond des écrans = fond du clavier (#0E0E0E). Visible aussi sous les barres système (bord à bord). -->
        <item name="android:windowBackground">@color/keyboard_background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:fontFamily">@font/open_sans</item>
        <!-- Lot 17 : contrôles standards aux couleurs de la charte (styles : styles.xml). -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_hint</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:colorControlNormal">@color/control_unchecked</item>
        <item name="android:colorControlActivated">@color/control_checked</item>
        <item name="android:editTextStyle">@style/TaipoInput</item>
        <item name="android:switchStyle">@style/TaipoSwitch</item>
        <item name="android:radioButtonStyle">@style/TaipoRadioButton</item>
        <item name="android:spinnerStyle">@style/TaipoSpinner</item>
        <item name="android:buttonStyle">@style/TaipoButton.Secondary</item>
    </style>

    <!-- Splashscreen (logo Junadé) : thème de MainActivity au lancement à froid, remplacé par AppTheme dès que
         MainActivity appelle installSplashScreen() (postSplashScreenTheme). Fond = fond de l'app (#0E0E0E, couleur fixe
         splash_background : le splash est résolu par le système, pas par le thème du clavier) pour que la transition vers
         l'accueil ne montre aucun saut de couleur. -->
    <style name="Theme.Taipo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <!-- Story 2.6 : fenêtre de modification d'un élément du presse-papiers. -->
    <style name="EditDialogTheme" parent="Platform.EditDialogTheme">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:fontFamily">@font/open_sans</item>
        <!-- Lot 17 : contrôles standards aux couleurs de la charte (styles : styles.xml). -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_hint</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:colorControlNormal">@color/control_unchecked</item>
        <item name="android:colorControlActivated">@color/control_checked</item>
        <item name="android:editTextStyle">@style/TaipoInput</item>
        <item name="android:switchStyle">@style/TaipoSwitch</item>
        <item name="android:radioButtonStyle">@style/TaipoRadioButton</item>
        <item name="android:spinnerStyle">@style/TaipoSpinner</item>
        <item name="android:buttonStyle">@style/TaipoButton.Secondary</item>
        <!-- Lot 17 : fenêtre aux couleurs et au rayon des boîtes du Smart Clipboard, écran assombri derrière. -->
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">@dimen/taipo_dialog_dim</item>
    </style>

    <!-- Pop-up d'information du clavier (remplace les toasts). -->
    <style name="MessageDialogTheme" parent="Platform.MessageDialogTheme">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:fontFamily">@font/open_sans</item>
        <!-- Lot 17 : contrôles standards aux couleurs de la charte (styles : styles.xml). -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:colorControlNormal">@color/control_unchecked</item>
        <item name="android:colorControlActivated">@color/control_checked</item>
        <item name="android:editTextStyle">@style/TaipoInput</item>
        <item name="android:switchStyle">@style/TaipoSwitch</item>
        <item name="android:radioButtonStyle">@style/TaipoRadioButton</item>
        <item name="android:spinnerStyle">@style/TaipoSpinner</item>
        <item name="android:buttonStyle">@style/TaipoButton.Secondary</item>
        <!-- Lot 17 : fenêtre aux couleurs et au rayon des boîtes du Smart Clipboard, écran assombri derrière. -->
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">@dimen/taipo_dialog_dim</item>
        <!-- Boutons du pop-up : action positive violette, les autres grises (même face + ombre que les écrans). -->
        <item name="android:buttonBarPositiveButtonStyle">@style/TaipoButton.Primary</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/TaipoButton.Secondary</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/TaipoButton.Secondary</item>
        <!-- Le message d'un AlertDialog est en textColorSecondary : blanc ici, pour rester lisible. -->
        <item name="android:textColorSecondary">@color/text_primary</item>
    </style>

    <!-- Thèmes Android de base, version claire (la version sombre est dans values-night/themes.xml). Barres système à icônes
         sombres sur le fond clair. -->
    <style name="Platform.AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
    <style name="Platform.EditDialogTheme" parent="android:Theme.Material.Light.Dialog.NoActionBar" />
    <style name="Platform.MessageDialogTheme" parent="android:Theme.Material.Light.Dialog.Alert" />
</resources>
