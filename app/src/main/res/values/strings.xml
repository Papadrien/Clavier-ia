    <string name="main_title">Taipo</string>
    <string name="main_description">Clavier Android minimal, bilingue français (AZERTY) / anglais (QWERTY) selon la langue active.\n\nPour l&#8217;utiliser :\n1. Appuyez sur «&#160;Activer le clavier&#160;»\n2. Activez «&#160;Taipo&#160;»\n3. Appuyez sur «&#160;Choisir la méthode de saisie&#160;» puis sélectionnez «&#160;Taipo&#160;».</string>
    <string name="button_enable">Activer le clavier</string>
    <string name="button_select">Choisir la méthode de saisie</string>
    <string name="button_model_settings">Modèle IA</string>

    <string name="model_settings_title">Modèle IA</string>
    <string name="model_settings_description">Prototype : aucun téléchargement. Choisissez un modèle dans la liste, puis fournissez vous-même le fichier .litertlm correspondant depuis le stockage du téléphone.</string>
    <string name="model_settings_spinner_label">Modèle</string>
    <string name="model_settings_model_info">Modèle technique : %1$s\n\nFormat attendu : fichier %2$s (LiteRT-LM)\n\n%3$s\n\nDépôt Hugging Face de référence : %4$s\n\nAucun checksum de référence n\'est vérifié dans ce prototype : seule la taille du fichier est comparée à titre indicatif.</string>
    <string name="model_settings_pick_file">Choisir le fichier .litertlm</string>
    <string name="model_settings_current_file">Fichier actuel : %1$s</string>
