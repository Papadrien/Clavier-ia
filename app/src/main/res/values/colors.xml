<?xml version="1.0" encoding="utf-8"?>
<!-- PALETTE CLAIRE (thème clair, prévu pour la V2 : ébauche rapide, à retravailler).
     La palette sombre, seule utilisée en V1, est dans values-night/colors.xml. Voir KeyboardTheme. -->
<resources>
    <color name="ic_launcher_background">#1E1E1E</color>

    <!-- Couleur d'accent commune : identique dans les deux palettes. -->
    <color name="accent">#5A7FD4</color>

    <!-- Texte principal et icônes. -->
    <color name="text_primary">#202124</color>

    <!-- Clavier (KeyboardView). -->
    <color name="keyboard_background">#FFE8EAED</color>
    <color name="key_normal">#FFFFFF</color>
    <color name="key_functional">#D3D6DB</color>
    <color name="key_pressed">#BFC3CA</color>
    <color name="key_enter">#80CBC4</color>
    <color name="key_label">#3C4043</color>
    <color name="key_popup">#F1F3F4</color>
    <color name="key_popup_selection">#80CBC4</color>
    <color name="key_hint">#70757A</color>

    <!-- Barre du haut, prompt, bande de suggestions, zone de chat. -->
    <color name="surface_button">#DADCE0</color>
    <color name="surface_pill">#FFFFFF</color>
    <color name="text_hint">#80868B</color>
    <color name="action_send">#2FA37A</color>
    <color name="action_danger">#C0392B</color>

    <!-- Smart Clipboard. -->
    <color name="clip_text_muted">#5F6368</color>
    <color name="clip_item">#FFFFFF</color>
    <color name="clip_item_pinned">#E3EAF8</color>
    <color name="clip_pin_badge">#7FA0E0</color>
    <color name="clip_dialog">#FFFFFF</color>
    <color name="clip_danger_text">#C5221F</color>
    <color name="scrim">#66000000</color>

    <!-- Écrans de réglages. -->
    <color name="settings_card">#F0F0F0</color>
    <color name="settings_divider">#D0D0D0</color>
    <color name="settings_warning_text">#B23C00</color>
</resources>
