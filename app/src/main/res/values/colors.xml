<?xml version="1.0" encoding="utf-8"?>
<!-- CHARTE TAIPO, palette CLAIRE (refonte graphique, lot 01 ; thèmes du clavier, lot T1-T3).
     Deux palettes de mêmes noms : values-night/colors.xml (sombre) et values/colors.xml (claire, ce fichier).
     Les écrans de l'application sont toujours sombres (KeyboardTheme.wrap force le mode nuit) ; le clavier choisit sa palette
     selon le thème (ThemeChoice, KeyboardTheme.mode). Ne modifier une valeur que dans la section « Charte » ; la section « Rôles »
     ne fait que nommer l'usage. Garde-fous : AccessibilityContrastTest (contrastes des deux palettes), RefonteResourcesRegressionTest (mêmes noms). -->
<resources>

    <!-- ===== Charte (valeurs de la plaquette) ===== -->
    <color name="taipo_background">#E4E4E8</color>
    <color name="taipo_purple">#8C00FF</color>
    <color name="taipo_purple_light">#C58BFF</color>
    <color name="taipo_purple_shadow">#6800AB</color>
    <color name="taipo_key">#F2F2F4</color>
    <color name="taipo_key_shadow">#B8B8C0</color>
    <color name="taipo_key_secondary">#CDCDD3</color>
    <color name="taipo_key_secondary_shadow">#A4A4AC</color>
    <color name="taipo_text">#1B1B1F</color>
    <!-- Barre centrale de la touche espace : gris foncé en thème clair (4:1 sur la touche secondaire, 3:1 exigé pour un élément graphique). -->
    <color name="taipo_space_bar">#5F5F66</color>
    <!-- Hors plaquette : texte sombre atténué (70 %) pour les textes secondaires (indices, hints). AA exige 4,5:1 ; AccessibilityContrastTest en garde la valeur sur chaque fond. -->
    <color name="taipo_text_muted">#B31B1B1F</color>

    <!-- ===== Rôles (noms utilisés par le code, inchangés) ===== -->
    <color name="accent">@color/taipo_purple</color>
    <color name="text_primary">@color/taipo_text</color>
    <!-- Fond de l'icône du lanceur (lot 18) : le fond sombre Taipo, fixe (le lanceur le résout hors du thème du clavier). -->
    <color name="ic_launcher_background">#0E0E0E</color>
    <!-- Fond du splashscreen : résolu par le système (pas par le thème du clavier), donc fixe, identique dans les deux palettes. -->
    <color name="splash_background">#0E0E0E</color>
    <!-- Texte et icônes posés sur un fond violet (touche Entrée, bouton envoyer, étiquette d'épingle…) : blanc dans les deux
         palettes, puisque le violet ne change pas. À ne pas confondre avec text_primary, qui devient sombre en thème clair. -->
    <color name="text_on_accent">#FFFFFF</color>
    <!-- Accent dessiné SUR une touche ou un bouton gris (chiffres d'appui long, trait étiré de la barre d'espace, étincelles) :
         violet plein (5,3:1 sur une touche claire, 3,7:1 sur une touche secondaire).
         Même nom dans les deux palettes ; ne pas confondre avec taipo_purple_light, fixe, qui est illisible sur du clair. -->
    <color name="accent_on_key">@color/taipo_purple</color>

    <!-- Clavier (KeyboardView). key_pressed : face d'une touche à bascule active (Maj, symboles) ; l'état pressé,
         lui, n'a pas de couleur propre (la touche s'enfonce, lot 05). -->
    <color name="keyboard_background">@color/taipo_background</color>
    <color name="key_normal">@color/taipo_key</color>
    <color name="key_functional">@color/taipo_key_secondary</color>
    <color name="key_pressed">@color/taipo_key_shadow</color>
    <color name="key_enter">@color/taipo_purple</color>
    <!-- Ombres (épaisseur inférieure) des touches, lot 04. -->
    <color name="key_normal_shadow">@color/taipo_key_shadow</color>
    <color name="key_functional_shadow">@color/taipo_key_secondary_shadow</color>
    <color name="key_enter_shadow">@color/taipo_purple_shadow</color>
    <color name="key_label">@color/taipo_text</color>
    <color name="key_popup">@color/taipo_key</color>
    <color name="key_popup_selection">@color/taipo_purple</color>
    <color name="key_hint">@color/taipo_text_muted</color>
    <!-- Barre centrale de la touche espace (lot 06). -->
    <color name="key_space_bar">@color/taipo_space_bar</color>

    <!-- Barre du haut, prompt, bande de suggestions, zone de chat. -->
    <color name="surface_button">@color/taipo_key_secondary</color>
    <color name="surface_pill">@color/taipo_key_secondary</color>
    <color name="text_hint">@color/taipo_text_muted</color>
    <color name="action_send">@color/taipo_purple</color>
    <!-- Rouge de danger : hors charte, conservé pour les actions destructives. -->
    <color name="action_danger">#C0392B</color>
    <!-- Ombre du rouge de danger (même rapport que les autres couples face / ombre) : bouton Vocal en écoute. -->
    <color name="action_danger_shadow">#7A241B</color>

    <!-- Panneau emoji (lot 14). La sélection (onglet actif) est violette ; la touche pressée dans la grille reprend la
         couleur des touches normales ; les touches ABC / retour arrière sont des touches secondaires (key_functional). -->
    <color name="emoji_tab_selected">@color/taipo_purple</color>
    <color name="emoji_tab_selected_shadow">@color/taipo_purple_shadow</color>
    <color name="emoji_tab_divider">@color/taipo_key_shadow</color>
    <color name="emoji_cell_pressed">@color/taipo_key</color>
    <color name="emoji_header_text">@color/taipo_text_muted</color>

    <!-- Smart Clipboard. -->
    <color name="clip_text_muted">@color/taipo_text_muted</color>
    <color name="clip_item">@color/taipo_key_secondary</color>
    <color name="clip_item_pinned">@color/taipo_key</color>
    <color name="clip_pin_badge">@color/taipo_purple</color>
    <!-- Lot 15 : ombres des cartes (face + ombre, comme les touches) et action principale du menu (violet). -->
    <color name="clip_item_shadow">@color/taipo_key_secondary_shadow</color>
    <color name="clip_item_pinned_shadow">@color/taipo_key_shadow</color>
    <color name="clip_action_primary">@color/taipo_purple</color>
    <color name="clip_action_primary_shadow">@color/taipo_purple_shadow</color>
    <color name="clip_dialog">@color/taipo_key_secondary</color>
    <color name="clip_danger_text">#9C1C14</color>
    <color name="scrim">#66000000</color>

    <!-- Écrans de réglages. settings_warning_text : orange d'avertissement, hors charte, conservé. -->
    <color name="settings_card">@color/taipo_key_secondary</color>
    <color name="settings_divider">@color/taipo_key_shadow</color>
    <color name="settings_warning_text">#7A4200</color>
    <!-- Lot 16 : boutons des écrans de réglages (face + ombre, comme les touches). Principal = violet, secondaire = gris. -->
    <color name="button_primary">@color/taipo_purple</color>
    <color name="button_primary_shadow">@color/taipo_purple_shadow</color>
    <color name="button_secondary">@color/taipo_key_secondary</color>
    <color name="button_secondary_shadow">@color/taipo_key_secondary_shadow</color>

    <!-- ===== Dialogues et contrôles Android (lot 17) : rôles, aucune nouvelle valeur hors charte ===== -->
    <color name="dialog_background">@color/taipo_key_secondary</color>
    <!-- Champs de saisie : fond plus sombre que la carte ou le dialogue qui le porte, trait au repos et au focus. -->
    <color name="input_background">@color/taipo_key</color>
    <color name="input_stroke">@color/taipo_key_secondary_shadow</color>
    <color name="input_stroke_focused">@color/taipo_purple</color>
    <!-- Commutateur, boutons radio : coché = violet, non coché = texte atténué ; pastille toujours blanche (switch_thumb ne suit pas taipo_text). -->
    <color name="control_checked">@color/taipo_purple</color>
    <color name="control_unchecked">@color/taipo_text_muted</color>
    <color name="switch_track_off">#86868F</color>
    <color name="switch_thumb">#FFFFFF</color>
    <!-- Ligne appuyée d'une liste déroulante ouverte. -->
    <color name="popup_item_pressed">@color/taipo_key</color>
</resources>
