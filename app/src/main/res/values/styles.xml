<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Styles des écrans de paramètres (lot 16). La structure reste en XML ; couleurs, tailles et espacements viennent
         de colors.xml et dimens.xml, la police du thème (Open Sans, lot 02). Les commutateurs, boutons radio, listes
         déroulantes et champs de saisie sont repris au lot 17 (en bas de ce fichier ; branchés dans themes.xml). -->

    <!-- Boutons : face + ombre (drawable), texte blanc sans majuscules forcées, sans élévation Material (l'ombre est dans
         le fond). La marge basse égale l'épaisseur d'ombre : le texte est centré sur la face. -->
    <style name="TaipoButton" parent="android:Widget.Material.Button">
        <item name="android:minHeight">@dimen/taipo_button_min_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">@dimen/taipo_button_text_size</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/taipo_button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/taipo_button_padding_horizontal</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">@dimen/taipo_button_shadow_height</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Principal : violet #8C00FF sur ombre #6800AB. -->
    <style name="TaipoButton.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
    </style>

    <!-- Secondaire : gris #2B2B2B sur ombre #191919. -->
    <style name="TaipoButton.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
    </style>

    <!-- Textes. Titres et textes d'introduction : blanc ; légendes : blanc atténué. -->
    <style name="TaipoText">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TaipoText.Display">
        <item name="android:textSize">@dimen/taipo_settings_text_display</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TaipoText.Title">
        <item name="android:textSize">@dimen/taipo_settings_text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TaipoText.Section">
        <item name="android:textSize">@dimen/taipo_settings_text_section</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TaipoText.Label">
        <item name="android:textSize">@dimen/taipo_settings_text_caption</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TaipoText.Lead">
        <item name="android:textSize">@dimen/taipo_settings_text_lead</item>
        <item name="android:lineSpacingMultiplier">@dimen/taipo_settings_line_spacing</item>
    </style>

    <style name="TaipoText.Body">
        <item name="android:textSize">@dimen/taipo_settings_text_body</item>
        <item name="android:lineSpacingMultiplier">@dimen/taipo_settings_line_spacing</item>
    </style>

    <!-- Texte d'information (état courant, fichier choisi) : même taille que la légende, mais en blanc. -->
    <style name="TaipoText.Info">
        <item name="android:textSize">@dimen/taipo_settings_text_caption</item>
        <item name="android:lineSpacingMultiplier">@dimen/taipo_settings_line_spacing</item>
    </style>

    <style name="TaipoText.Caption">
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">@dimen/taipo_settings_text_caption</item>
        <item name="android:lineSpacingMultiplier">@dimen/taipo_settings_line_spacing</item>
    </style>

    <style name="TaipoText.Small">
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">@dimen/taipo_settings_text_small</item>
        <item name="android:lineSpacingMultiplier">@dimen/taipo_settings_line_spacing</item>
    </style>

    <style name="TaipoText.Status">
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:textSize">@dimen/taipo_settings_text_status</item>
        <item name="android:textStyle">italic</item>
    </style>

    <!-- ===== Contrôles Android standards (lot 17) =====
         Ils gardent leur comportement natif (accessibilité, TalkBack, états) ; seuls couleurs, fonds et tailles viennent
         de la charte. Branchés par les thèmes (themes.xml), donc appliqués aussi aux vues créées en code. -->

    <!-- Champ de saisie : fond sombre à trait fin, trait violet au focus, texte blanc, indice atténué. -->
    <style name="TaipoInput" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">@dimen/taipo_input_text_size</item>
        <item name="android:padding">@dimen/taipo_settings_card_padding</item>
        <item name="android:minHeight">@dimen/taipo_button_min_height</item>
    </style>

    <!-- Commutateur : piste violette / grise, pastille blanche, libellé blanc. Pas de texte Oui/Non sur la piste. -->
    <style name="TaipoSwitch" parent="android:Widget.Material.CompoundButton.Switch">
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:thumbTint">@null</item>
        <item name="android:trackTint">@null</item>
        <item name="android:showText">false</item>
        <item name="android:minHeight">@dimen/taipo_settings_row_min_height</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/taipo_settings_text_lead</item>
    </style>

    <!-- Bouton radio : rond violet une fois coché, blanc atténué sinon ; libellé blanc. -->
    <style name="TaipoRadioButton" parent="android:Widget.Material.CompoundButton.RadioButton">
        <item name="android:buttonTint">@color/control_tint</item>
        <item name="android:minHeight">@dimen/taipo_settings_row_min_height</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/taipo_settings_text_lead</item>
    </style>

    <!-- Liste déroulante : fond de champ de saisie avec flèche, liste ouverte sur le fond des dialogues. -->
    <style name="TaipoSpinner" parent="android:Widget.Material.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:popupBackground">@drawable/bg_dialog</item>
        <item name="android:paddingStart">@dimen/taipo_settings_card_padding</item>
        <item name="android:paddingEnd">@dimen/taipo_spinner_padding_end</item>
        <item name="android:dropDownVerticalOffset">0dp</item>
    </style>
</resources>
