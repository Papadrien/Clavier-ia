<?xml version="1.0" encoding="utf-8"?>
<!--
    Sauvegarde automatique (Android 6 à 11). Le dictionnaire personnel est
    chiffré avec une clé de l'Android Keystore, qui ne suit pas une
    restauration : base et clé chiffrée sont donc exclues ensemble.
-->
<full-backup-content>
    <exclude domain="database" path="personal_dictionary.db" />
    <exclude domain="database" path="personal_dictionary.db-journal" />
    <exclude domain="database" path="personal_dictionary.db-wal" />
    <exclude domain="database" path="personal_dictionary.db-shm" />
    <exclude domain="database" path="clipboard.db" />
    <exclude domain="database" path="clipboard.db-journal" />
    <exclude domain="database" path="clipboard.db-wal" />
    <exclude domain="database" path="clipboard.db-shm" />
    <exclude domain="sharedpref" path="personal_dictionary_key.xml" />
    <exclude domain="sharedpref" path="clipboard_key.xml" />
    <exclude domain="file" path="next_word_model.enc" />
    <exclude domain="file" path="next_word_model.enc.tmp" />
    <exclude domain="sharedpref" path="next_word_key.xml" />
    <!-- Lot 3.4 (S2) : modèles IA copiés depuis le stockage de l'utilisateur (plusieurs Go). La sauvegarde
         automatique est plafonnée (25 Mo) : sans cette exclusion, elle serait désactivée pour toute l'app,
         et le transfert d'appareil copierait les modèles. L'utilisateur les re-sélectionne après restauration. -->
    <exclude domain="file" path="models/" />
    <exclude domain="file" path="voice-model/" />
</full-backup-content>
