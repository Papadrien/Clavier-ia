<?xml version="1.0" encoding="utf-8"?>
<!-- CHARTE TAIPO, palette « Couleur dynamique » CLAIRE (lot T7, Android 12+).
     Remplace les valeurs de la charte (section « Charte » de values/colors.xml) par les tons du fond d'écran
     (@android:color/system_accent1_* et system_neutral1_*) ; les rôles, qui ne font que nommer l'usage, ne sont pas redéclarés.
     QUALIFICATIF « desk » : détourné pour que SEULE la configuration en couleur dynamique choisisse ces fichiers.
     KeyboardTheme.configuration force le type d'interface à « desk » pour ce thème (clavier, et écrans de l'application via
     KeyboardTheme.wrap) et à « normal » pour tous les autres.
     Les deux fichiers (clair et sombre) déclarent les mêmes noms (AccessibilityContrastTest). Les tons ne se mesurent pas hors
     de l'appareil (ils dépendent du fond d'écran) : à juger à l'écran, texte blanc sur accent1_600 compris. -->
<resources>
    <color name="taipo_background">@android:color/system_neutral1_100</color>
    <color name="taipo_purple">@android:color/system_accent1_600</color>
    <color name="taipo_purple_light">@android:color/system_accent1_300</color>
    <color name="taipo_purple_shadow">@android:color/system_accent1_800</color>
    <color name="taipo_key">@android:color/system_neutral1_10</color>
    <color name="taipo_key_shadow">@android:color/system_neutral1_300</color>
    <color name="taipo_key_secondary">@android:color/system_neutral1_200</color>
    <color name="taipo_key_secondary_shadow">@android:color/system_neutral1_400</color>
    <color name="taipo_text">@android:color/system_neutral1_900</color>
    <color name="taipo_space_bar">@android:color/system_neutral1_700</color>
    <color name="taipo_text_muted">@android:color/system_neutral1_700</color>
</resources>
