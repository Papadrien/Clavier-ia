# Réglages communs de l'éditeur et de ktlint (lot 4.1, voir docs/qualite.md) : style Android Studio, lignes de 160 caractères
# (même limite que detekt, config/detekt/detekt.yml).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 160
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Convention du projet : paramètres d'un constructeur ou d'une fonction sur plusieurs lignes, même quand ils tiendraient sur une
# seule. Ces deux règles réclament l'inverse (640 écarts sur 1 753, aucun de fond) : désactivées.
ktlint_standard_class-signature = disabled
ktlint_standard_function-signature = disabled

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
